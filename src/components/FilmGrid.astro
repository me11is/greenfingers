---
import type { CollectionEntry } from 'astro:content';

interface Props {
  films: CollectionEntry<'films'>[],
  limit?: number 
}

const { films, limit } = Astro.props as Props;

---

<ul>
    {
        [...films]
        .sort((a,b) => a.data.order - b.data.order)
        .slice(0, limit ?? undefined)
        .map((film) => {
            const {title, year, clip} = film.data
            const slug = title.toLowerCase().replaceAll(' ', '-')

            return (
                <li>
                    <a class="film-grid-item" href={'film/' + slug}>
                        <article>
                            <div class="video-wrap">

                                <div class="video-skeleton"></div>

                                <video
                                    autoplay
                                    loop
                                    muted
                                    playsinline
                                >
                                    <source src={clip} type="video/mp4"/>
                                </video>

                                <div class="film-title">
                                    <p>{title}</p>
                                </div>

                            </div>
                        </article>
                    </a>
                </li>
            )
        })
    }
</ul>


<style>
ul {
    display: grid;
    min-width: 100%;
    grid-template-columns: repeat(1, 1fr);
    row-gap: .6rem;
    padding: 0;
    max-width: 90vw;
}

li {
    list-style: none;
}

article {
    display: flex;
    flex-direction: column;
}


/* VIDEO AREA */

div.video-wrap {
    line-height: 0;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 9;
    background: #111;
}


/* SKELETON */

.video-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        #111 25%,
        #222 50%,
        #111 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    z-index: 1;
    transition: opacity .5s ease;
}


.video-wrap.loaded .video-skeleton {
    opacity: 0;
    pointer-events: none;
}


@keyframes shimmer {
    from {
        background-position: 200% 0;
    }

    to {
        background-position: -200% 0;
    }
}


/* VIDEO */

video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity .6s ease;
}


.video-wrap.loaded video {
    opacity: 1;
}


/* TITLE */

div.film-title {
    position: absolute;
    bottom: .2rem;
    left: .8rem;
    z-index: 2;
}


div.film-title p {
    font-family: var(--font-humane);
    text-transform: uppercase;
    color: var(--color-mint);
    font-size: 2.8rem;
    line-height: 1;
    margin: 0;
}


@media (min-width: 768px) {

    ul {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 0.8rem;
        column-gap: .8rem;
    }

}


@media (min-width: 1024px) {

    div.film-title p {
        font-size: 3rem;
    }

}
</style>


<script>
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger)


// VIDEO LOADING

document.querySelectorAll(".video-wrap video").forEach(video => {

    const wrapper = video.closest(".video-wrap");

    video.addEventListener("loadeddata", () => {
        wrapper?.classList.add("loaded");
    });

    // fallback in case browser already loaded it
    if (video.readyState >= 2) {
        wrapper?.classList.add("loaded");
    }

});


// SCROLL ANIMATION

gsap.utils.toArray(".film-grid-item").forEach(item => {

    gsap.from(item, {
        opacity: 0,
        y: 50,
        duration: 0.8,
        ease: "sine.out",
        scrollTrigger: {
            trigger: item,
            start: "top 90%"
        }
    });

});


// BF CACHE FIX

window.addEventListener("pageshow", (event) => {

    if (event.persisted) {

        document.querySelectorAll("video").forEach((video) => {

            video.pause();
            video.currentTime = 0;

            video.play().catch(() => {});

        });

    }

});
</script>