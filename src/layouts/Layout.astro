---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-humane" />
		<Font cssVariable="--font-body" />
		
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

		<title>Greenfingers</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
html,''
body {
	margin: 0;
	width: 100%;
	height: 100%;
}
	/* Box sizing */
*,
*::before,
*::after {
box-sizing: border-box;
}

/* Remove default spacing */
* {
margin: 0;
}

/* Better defaults */
html {
-webkit-text-size-adjust: 100%;
text-size-adjust: 100%;
scroll-behavior: smooth;
}

body {
min-height: 100vh;
line-height: 1.5;
text-rendering: optimizeLegibility;
-webkit-font-smoothing: antialiased;
}

/* Media defaults */
img,
picture,
video,
canvas,
svg {
display: block;
max-width: 100%;
}

/* Form controls inherit fonts */
input,
button,
textarea,
select {
font: inherit;
}

/* Prevent text overflow issues */
p,
h1,
h2,
h3,
h4,
h5,
h6 {
overflow-wrap: break-word;
}

/* Headings wrap nicely */
h1,
h2,
h3,
h4,
h5,
h6 {
text-wrap: balance;
}

/* Paragraphs wrap more naturally */
p {
text-wrap: pretty;
}

/* Lists only lose bullets when explicitly marked */
ul[role="list"],
ol[role="list"] {
list-style: none;
padding: 0;
}

/* Anchor improvements */
a {
color: inherit;
}

:root {
/* Colours */
--color-mint: #E3FFED;
--color-dark-green: #1F3727;
--footer-height: 90vh;

}

body {
background-color: var(--color-dark-green);
}

h1,h2,h3,h4,h5 {
color: var(--color-mint);
font-family: var(--font-humane);
text-transform: uppercase;
line-height: 1;
}

h2 {
	font-size: 5rem;
}

section:not(:first-of-type) {
	padding: 3rem 1rem;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}

p {
	color: var(--color-mint);
	font-family: var(--font-body);
}

	/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
	html:focus-within {
		scroll-behavior: auto;
	}

	*,
	*::before,
	*::after {
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.01ms !important;
		scroll-behavior: auto !important;
	}
}

@media (min-width: 768px) {
  /* tablet */
}

@media (min-width: 1024px) {
	h2 {
		font-size: 12rem;
	}

	section:not(:first-of-type) {
		padding: 4rem 2rem;
	}
}

@media (min-width: 1200px) {
 /* desktops */
}
</style>

