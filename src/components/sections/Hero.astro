---
import Logo from "../../assets/greenfingers.svg";
---

<section class="hero" id="hero">
  <video
    id="hero-video"
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
    preload="metadata"
    poster="/src/assets/images/hero-poster.png"
  >
    <source src="/videos/hero-vid.webm" type="video/webm" />
    <source src="/videos/hero-vid.mp4" type="video/mp4" />
  </video>

  <div class="hero-content">
    <Logo />
  </div>

  <div class="fader"></div>
</section>

<style>
  .hero {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    height: 120vh;
  }

  .fader {
    width: 100%;
    height: 20vh;
    background: var(--dark-green);
    background: linear-gradient(
      180deg,
      rgba(31, 55, 39, 0) 0%,
      rgba(31, 55, 39, 0.5746892507002801) 39%,
      rgba(31, 55, 39, 0.9472382703081232) 79%,
      rgba(31, 55, 39, 1) 100%
    );
    position: absolute;
    bottom: 0;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100vw;
    height: 100dvh;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .hero svg {
    position: absolute;
    left: 0;
    max-width: 90%;
    padding: .6rem;
  }

  @media (min-width: 768px) {
    /* tablet */
    .hero svg {
      max-width: 70%;
      padding: 1rem;
    }
  }

  @media (min-width: 1024px) {
    /* laptops */
  }

  @media (min-width: 1200px) {
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".hero svg",
      start: "bottom bottom",
      end: "bottom top",
      scrub: 1

    }
  })
  tl.to(".hero svg", {
    scale: 0.4,
    top: 0,
    left: 0,
    transformOrigin: "top left"
  })
</script>
