---
import { getImage } from 'astro:assets';
import Logo from "./src/assets/greenfingers.svg";
---

<section class="hero" id="hero">
  <video
    id="hero-video"
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  >
    <source
      src="/videos/hero-vid.mp4"
      type="video/mp4"

    />
  </video>

  <div class="hero-content">
    <Logo  />
  </div>

  <div class="fader"></div>

</section>

<style>
.hero {
  position: relative;
  width: 100vw;
  min-height: 100vh;
  height: 120vh;
}

.hero svg {
  max-width: 60vw;
  margin-bottom: -3rem;
}

.fader {
  width: 100%;
  height: 20vh;
  background: var(--dark-green);
  background: linear-gradient(
    180deg,
    rgba(31, 55, 39, 0) 0%,
    rgba(31, 55, 39, 0.5746892507002801) 39%,
    rgba(31, 55, 39, 0.9472382703081232) 79%,
    rgba(31, 55, 39, 1) 100%
  );
  position: absolute;
  bottom: 0;
}

.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-content {
  position: relative;
  z-index: 1;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding-left: 1.6rem;
  padding-bottom: 1rem;
}

@media (min-width: 768px) {
  /* tablet */
    .hero svg {
      margin-bottom: -1rem;
    }
}

@media (min-width: 1024px) {
  /* laptops */
      .hero svg {
      margin-bottom: 0rem;
    }
}

@media (min-width: 1200px) {

}


</style>