---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { marked } from "marked";

export const getStaticPaths = (async () => {
  const films = await getCollection("films");
  return films.map((film) => ({
    params: {
      slug: film.data.title.toLowerCase().replaceAll(" ", "-"),
    },
    props: {
      film,
    },
  }));
}) satisfies GetStaticPaths;

const { film } = Astro.props;
const { title, year, link, crew, cast, synopsis, directors } = film.data;
const parsedCrew = marked.parse(crew);
const parsedCast = marked.parse(cast);

function getYouTubeEmbedUrl(url) {
    let videoId = '';

    try {
        const parsed = new URL(url);

        // https://youtu.be/VIDEO_ID
        if (parsed.hostname === 'youtu.be') {
            videoId = parsed.pathname.slice(1);
        }

        // https://www.youtube.com/watch?v=VIDEO_ID
        else if (parsed.pathname === '/watch') {
            videoId = parsed.searchParams.get('v');
        }

        // Already an embed URL
        else if (parsed.pathname.startsWith('/embed/')) {
            videoId = parsed.pathname.split('/embed/')[1];
        }

        // Shorts URL
        else if (parsed.pathname.startsWith('/shorts/')) {
            videoId = parsed.pathname.split('/shorts/')[1];
        }

        if (!videoId) return null;

        // Remove any accidental extra path/query
        videoId = videoId.split('/')[0].split('?')[0];

        return `https://www.youtube.com/embed/${videoId}`;
    } catch {
        return null;
    }
}

const youtubeLink = getYouTubeEmbedUrl(link)
---

<Layout>
  <Navbar />
  <section>
  <div class="youtube-container">
    <iframe
      src={youtubeLink}
      title="YouTube video player"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen>
    </iframe>
  </div>
    <div class="details">
      <div class="title">
        <h3>Title</h3>
        <p>{title}</p>
      </div>
      <div class="year">
        <h3>Year</h3>
        <p>{year}</p>
      </div>
      <div class="directors">
        <h3>Directors</h3>
        <p>{directors}</p>
      </div>
      <div class="synopsis">
        <h3>Synopsis</h3>
        <p>{synopsis}</p>
      </div>
      <div class="crew">
        <h3>Crew</h3>
        <p set:html={parsedCrew} />
      </div>
      <div class="cast">
        <h3>Cast</h3>
        <p set:html={parsedCast} />
      </div>
    </div>
  </section>
</Layout>

<style>
    html,
    body {
    background: #111;
    }

  section {
    padding: 6rem 1rem;
    background: #111;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .youtube-container {
    width: 100%;
    max-width: 1080px;
    aspect-ratio: 16 / 9;
}

  .youtube-container iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }


  .details {
    margin-top: 1.4rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 1rem;
    column-gap: .4rem;
    width: 100%;
    max-width: 1080px;
  }

  .details h3,
  .details :global(p) {
    font-family: var(--font-mono);
    letter-spacing: -6%;
    font-size: 0.7rem;
  }

  .details h3 {
    margin-bottom: 0.4rem;
    opacity: 0.5;
  }

  .details :global(p) {
    font-size: 0.8rem;
  }

  .synopsis {
    grid-column: span 3;
  }

  .cast {
    grid-column: 3;
  }

  @media (min-width: 768px) {
    /* tablet */
  }

  @media (min-width: 1024px) {
  }
</style>
