---
import Plane from "../../assets/plane.svg";
import FooterSvg from "../../assets/footer.svg";
---

<section id="contact">
    <h3>
        Want to chat? Get in touch using the email below or any of our socials
    </h3>
    <button class="email-button">
        <div class="icon-with-text">
            <Plane width="18px" />
            <p>hello@greenfingersfilm.com</p>
        </div>
        <p class="copy-text">click to copy</p>
    </button>
    <div class="all-links">
        <ul class="nav-links">
            <li>Navigation</li>
            <li><a href="#">Home</a></li>
            <li><a href="#films">Films</a></li>
            <li><a href="#about">About Us</a></li>
            <li><a href="/films">All Films</a></li>
        </ul>
        <ul class="social-links">
            <li>Socials</li>
            <li>
                <a
                    href="https://www.instagram.com/greenfingers_film/"
                    target="_blank">Instagram</a>
            </li>
            <li>
                <a
                    href="https://vimeo.com/user2817712?fl=pp&fe=sh"
                    target="_blank">Vimeo</a>
            </li>
            <li>
                <a
                    href="https://www.youtube.com/@greenfingersfilm"
                    target="_blank">YouTube</a>
            </li>
            <li>
                <a
                    href="https://www.tiktok.com/@greenfingersfilm"
                    target="_blank">TikTok</a>
            </li>
        </ul>
    </div>
    <div class="footer-svg-container">
        <FooterSvg />
    </div>
</section>

<style>
    #contact {
        padding-bottom: 0;
    }

    h3 {
        font-family: var(--font-body);
        text-transform: none;
        letter-spacing: -3%;
        font-weight: 500;
        margin-bottom: 2rem;
    }

    .email-button {
        all: unset;
        cursor: pointer;
        box-sizing: border-box;
        background: var(--color-accent);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 0.6rem;
        width: 100%;
        border-radius: 12px;
        border: 1px solid #111;
        box-shadow: -2px 2px 0 0 #111111;
    }

    .email-button p {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: -5%;
    }

    .icon-with-text {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .copy-text {
        height: 100%;
        line-height: 4;
        padding-left: 0.6rem;
        border-left: 1px solid #111;
    }

    .all-links {
        display: flex;
        width: 100%;
        gap: 4rem;
        margin-top: 3rem;
    }

    .all-links ul {
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: -5%;
        color: var(--color-mint);
    }

    .all-links ul li:first-child {
        opacity: 0.6;
    }

    .footer-svg-container {
        /* border: 2px solid red; */
        overflow: hidden;
    }

    .footer-svg-container svg {
        width: 100vw;
        height: auto;
        display: block;
        transform: translateY(3rem);
    }

    @media (min-width: 768px) {
        /* tablet */
        h3 {
            font-size: 1.8rem;
            text-wrap: initial;
            max-width: 80vw;
        }

        .email-button {
            max-width: 70vw;
        }

        .all-links {
            gap: 8rem;
        }

        .all-links ul {
            font-size: .9rem;
        }

        .footer-svg-container svg {
            transform: translateY(3.6rem);
        }
    }

    @media (min-width: 1024px) {
        /* laptops */
        .footer-svg-container svg {
            transform: translateY(6rem);
        }
    }

    @media (min-width: 1200px) {
        /* desktops */
    }
</style>

<script>
    import JSConfetti from "js-confetti";

    const jsConfetti = new JSConfetti();

    const copyButton = document.querySelectorAll(".email-button");
    const copyText = document.querySelectorAll(".copy-text");

    function copyEmail() {
        navigator.clipboard.writeText("hello@greenfingersfilm.com");
        copyText.forEach((item) => (item.textContent = "copied!"));
        jsConfetti.addConfetti({
            emojis: ["💌", "✉️"],
            confettiRadius: 4,
            confettiNumber: 70,
        });
        setTimeout(() => {
            copyText.forEach((item) => (item.textContent = "click to copy"));
        }, 2000);
    }

    copyButton.forEach((button) => button.addEventListener("click", copyEmail));
</script>
