---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
	<head>
		<meta 
			name="viewport" 
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta charset="UTF-8" />

		<Font cssVariable="--font-humane" />
		<Font cssVariable="--font-body" />
		<Font cssVariable="--font-mono" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MyWebSite" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO -->
		<title>
			Greenfingers | Award-Winning Film Collective & Video Production Manchester
		</title>

		<meta 
			name="description" 
			content="Greenfingers is an award-winning Manchester film collective creating bold, surreal and genre-bending films, commercials and branded content."
		/>

		<link rel="canonical" href="https://www.greenfingers.film/" />


		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Greenfingers | Award-Winning Film Collective Manchester" />
		<meta 
			property="og:description" 
			content="An internationally award-winning film collective from Manchester creating bold, surreal and genre-bending films."
		/>
		<meta property="og:url" content="https://www.greenfingers.film/" />
		<meta property="og:site_name" content="Greenfingers" />
		<meta property="og:image" content="https://www.greenfingers.film/social-image.jpg" />


		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Greenfingers | Film Collective Manchester" />
		<meta 
			name="twitter:description" 
			content="Award-winning directors creating surreal, genre-bending films and branded content."
		/>
		<meta name="twitter:image" content="https://www.greenfingers.film/social-image.jpg" />


		<!-- Business Schema -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Greenfingers",
			"description": "Internationally award-winning film collective based in Manchester creating films, commercials and branded content.",
			"url": "https://www.greenfingers.film/",
			"logo": "https://www.greenfingers.film/favicon.svg",
			"location": {
				"@type": "Place",
				"name": "Manchester, UK"
			},
			"areaServed": [
				"Manchester",
				"United Kingdom",
				"International"
			],
			"knowsAbout": [
				"Film production",
				"Commercial video production",
				"Music videos",
				"Branded content",
				"Directing",
				"Cinematography"
			],
			"founders": [
				{
					"@type": "Person",
					"name": "Elliot Taylor"
				},
				{
					"@type": "Person",
					"name": "Lucy Hilton-Jones"
				},
				{
					"@type": "Person",
					"name": "Dann Cooper"
				}
			]
		}
		</script>


		<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

	</head>

	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	"" body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	/* Box sizing */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	/* Remove default spacing */
	* {
		margin: 0;
	}

	/* Better defaults */
	html {
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
		scroll-behavior: smooth;
	}

	body {
		min-height: 100vh;
		line-height: 1.5;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	/* Media defaults */
	img,
	picture,
	video,
	canvas,
	svg {
		display: block;
		max-width: 100%;
	}

	/* Form controls inherit fonts */
	input,
	button,
	textarea,
	select {
		font: inherit;
	}

	/* Prevent text overflow issues */
	p,
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		overflow-wrap: break-word;
	}

	/* Headings wrap nicely */
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		text-wrap: balance;
	}

	/* Paragraphs wrap more naturally */
	p {
		text-wrap: pretty;
	}

	/* Lists only lose bullets when explicitly marked */
	ul[role="list"],
	ol[role="list"] {
		list-style: none;
		padding: 0;
	}

	/* Anchor improvements */
	a {
		color: inherit;
	}

	:root {
		/* Colours */
		--color-mint: #e3ffed;
		--color-dark-green: #1f3727;
		--color-accent: #285f4b;
	}

	body {
		background-color: var(--color-dark-green);
	}

	h1,
	h2,
	h3,
	h4,
	h5 {
		color: var(--color-mint);
		font-family: var(--font-humane);
		text-transform: uppercase;
		line-height: 1;
	}

	h2 {
		font-size: 5rem;
	}

	section:not(:first-of-type) {
		padding: 3rem .6rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	p {
		color: var(--color-mint);
		font-family: var(--font-body);
	}

	/* Respect reduced motion */
	@media (prefers-reduced-motion: reduce) {
		html:focus-within {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}

	@media (min-width: 768px) {
		/* tablet */
		section:not(:first-of-type) {
			padding: 3rem 1rem;
		}
	}

	@media (min-width: 1024px) {
		h2 {
			font-size: 12rem;
		}

		section:not(:first-of-type) {
			padding: 4rem 2rem;
		}
	}

	@media (min-width: 1200px) {
		/* desktops */
	}
</style>

<script></script>
