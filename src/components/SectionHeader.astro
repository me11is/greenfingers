---
interface Props {
  text: string;
}

const { text } = Astro.props;

const letters = [...text];

const styled = letters.map(letter => ({
  letter,
  thin: letter.trim() !== "" && Math.random() < 0.3
}));
---
<h2 class="section-header">
    <span class="text">
        {styled.map(({ letter, thin }) => (
            <span class:list={{ thin }}>{letter}</span>
        ))}
    </span>
</h2>

<style>
    h2 {
        margin-bottom: 1rem;
    }

    .section-header span {
        font-weight: 700;
    }

    .section-header span.thin {
        font-weight: 100;
    }
</style>

<script>
</script>



